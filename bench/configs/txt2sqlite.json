{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0,
        "percentage": 0
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "bench/data/rows-500k.txt"
            ],
            "fieldDelimiter": ",",
            "skipHeader": false,
            "column": [
              {
                "index": 0,
                "type": "long"
              },
              {
                "index": 1,
                "type": "string"
              },
              {
                "index": 2,
                "type": "string"
              },
              {
                "index": 3,
                "type": "long"
              },
              {
                "index": 4,
                "type": "double"
              },
              {
                "index": 5,
                "type": "string"
              },
              {
                "index": 6,
                "type": "string"
              },
              {
                "index": 7,
                "type": "string"
              },
              {
                "index": 8,
                "type": "date"
              },
              {
                "index": 9,
                "type": "date"
              },
              {
                "index": 10,
                "type": "long"
              },
              {
                "index": 11,
                "type": "string"
              }
            ]
          }
        },
        "writer": {
          "name": "sqlitewriter",
          "parameter": {
            "column": [
              "id",
              "name",
              "email",
              "age",
              "score",
              "status",
              "city",
              "payload",
              "created_at",
              "updated_at",
              "flag",
              "note"
            ],
            "writeMode": "insert",
            "batchSize": 1024,
            "preSql": [
              "DROP TABLE IF EXISTS bench_dest",
              "CREATE TABLE bench_dest (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, age INTEGER NOT NULL, score REAL NOT NULL, status TEXT NOT NULL, city TEXT NOT NULL, payload TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, flag INTEGER NOT NULL, note TEXT NULL)"
            ],
            "connection": [
              {
                "jdbcUrl": ["jdbc:sqlite:bench/data/file2sqlite.db"],
                "table": [
                  "bench_dest"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
